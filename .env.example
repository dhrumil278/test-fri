# Environment variables for the Wealth Management application

# Database configuration
DB_DATABASE=<DATABASE_NAME>
DB_USER=<DATABASE_USER_NAME>
DB_PASSWORD=<DATABASE_PASSWORD>
DB_HOST=<DATABASE_HOST>
DB_PORT=<DATABASE_PORT>

# Email configuration for sending notifications
ETHEREAL_USERNAME=<ETHEREAL_USERNAME>
ETHEREAL_PASSWORD=<ETHEREAL_PASSWORD>
GMAIL_HOST=<GMAIL_HOST>
GMAIL_PORT=<SMTP_PORT>
GMAIL=<GMAIL_EMAIL>

AWS_ACCESS_KEY=<YOUR_AWS_ACCESS_KEY>
AWS_SECRET_KEY=<YOUR_AWS_SECRET_KEY>
AWS_REGION=<YOUR_AWS_REGION>
AWS_BUCKET_NAME=<YOUR_AWS_BUCKET_NAME>

# Port configuration
PORT=<PORT_VALUE>

# JWT secret for signing tokens
JWT_SECRET=<JWT_SECRET>

# Key for encrypt the data
ENCRYPTION_KEY=<ENCRYPTION_KEY>

# Base URL for the frontend panel
FRONTEND_BASE_ADMIN_URL=<FRONTEND_BASE_ADMIN_URL>